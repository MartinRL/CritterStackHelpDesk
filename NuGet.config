<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Unreleased xmlang-repo packs (emlang-v0.5.0 / xmlang-v0.6.1) while the upstream release
         workflow is red. Delete the folder + this line once they are on nuget.org. -->
    <add key="local" value="local-nuget" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- .NET 11 nightly packages (e.g. Microsoft.AspNetCore.App.Internal.Assets) that the
         nightly preview SDK requires but that never ship to nuget.org. -->
    <add key="dotnet11" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet11/nuget/v3/index.json" />
  </packageSources>
</configuration>
